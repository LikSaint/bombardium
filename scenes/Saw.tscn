[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/Saw.gd" id="1"]

[node name="Saw" type="Node2D"]
script = ExtResource("1")

[node name="EmergeTimer" type="Timer" parent="."]
wait_time = 0.5
one_shot = true
autostart = true

[node name="StepTimer" type="Timer" parent="."]
wait_time = 0.22
one_shot = false

[connection signal="timeout" from="EmergeTimer" to="." method="_on_emerge_timeout"]
[connection signal="timeout" from="StepTimer" to="." method="_on_step_timer_timeout"]
